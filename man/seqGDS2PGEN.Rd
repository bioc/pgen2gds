\name{seqGDS2PGEN}
\alias{seqGDS2PGEN}
\title{Convert SeqArray GDS to PLINK2 PGEN files}
\description{
    Converts a SeqArray GDS file to PLINK2 pgen, pvar and psam files.
}

\usage{
seqGDS2PGEN(gdsfile, out.fn,
    write.rsid=c("auto", "annot_id", "chr_pos_ref_alt"),
    half.call=c("missing", "haploid"), use.phase=TRUE, chr_prefix="",
    verbose=TRUE)
}

\arguments{
    \item{gdsfile}{a \code{\link[SeqArray]{SeqVarGDSClass}} object or a file
        name of SeqArray GDS}
    \item{out.fn}{the file name prefix of the output PLINK2 files;
        \code{out.fn.pgen}, \code{out.fn.pvar} and \code{out.fn.psam} are
        created}
    \item{write.rsid}{\code{"auto"}: use \code{annotation/id} and fall back
        to \code{"chr_pos_ref_alt"} when the ID is missing or \code{"."};
        \code{"annot_id"}: use \code{annotation/id} only;
        \code{"chr_pos_ref_alt"}: use "chromosome_position_ref_alt"}
    \item{half.call}{how to handle a genotype with one missing allele (a half
        call or a haploid call): \code{"missing"} (default) codes it as
        missing, \code{"haploid"} codes it as homozygous for the observed
        allele}
    \item{use.phase}{if \code{TRUE}, write the phase information of
        heterozygous genotypes to the pgen file}
    \item{chr_prefix}{the prefix of chromosome codes, e.g., "chr"; it can be
        used to restore the prefix removed by \code{ignore.chr.prefix} in
        \code{\link{seqPGEN2GDS}}}
    \item{verbose}{if \code{TRUE}, show information}
}

\details{
    The sample and variant selections set by
\code{\link[SeqArray]{seqSetFilter}} are respected, so \code{seqGDS2PGEN()}
can export a subset of the GDS file. The ploidy has to be 2. Dosages are not
exported.

    The pgen file uses the PLINK2 storage mode 0x10. Each variant record is
stored in the smallest of the dense 2-bit, 1-bit and difference-list
encodings, following the thresholds used by PLINK2, and multiallelic genotypes
and hardcall phase are stored in the corresponding auxiliary data tracks. The
LD-based encodings of PLINK2 (differences from the previous variant) are not
used, so the pgen file can be slightly larger than the file generated by PLINK2
itself, especially for datasets with many common variants in strong linkage
disequilibrium. If the smallest file size is required, the files can be
re-encoded by PLINK2, e.g., \code{plink2 --pfile out.fn --make-pgen --out
new.fn}.

    The pgen format keeps phase information for heterozygous genotypes only,
so the phase flags of homozygous and haploid genotypes in the GDS file are
ignored without loss of information.

    The pvar file has the columns \code{#CHROM}, \code{POS}, \code{ID},
\code{REF} and \code{ALT}, where \code{REF} and \code{ALT} are taken from the
GDS variable \code{allele}. If the chromosome codes are not recognized by
PLINK2 (e.g., non-standard contig names), \code{--allow-extra-chr} may be
needed when the files are loaded in PLINK2.

    The psam file has the column \code{IID} from \code{sample.id}, and the
columns \code{FID}, \code{PAT}, \code{MAT}, \code{SEX} and \code{PHENO1} when
the GDS variables \code{sample.annotation/family},
\code{sample.annotation/father}, \code{sample.annotation/mother},
\code{sample.annotation/sex} and \code{sample.annotation/phenotype} exist
(the same variables as created by \code{\link[SeqArray]{seqBED2GDS}} and
\code{\link{seqPGEN2GDS}}).
}

\value{
    Return the file names of the pgen, pvar and psam files with absolute
paths.
}

\references{
    \url{https://www.cog-genomics.org/plink/2.0/}
}
\author{Xiuwen Zheng}
\seealso{
    \code{\link{seqPGEN2GDS}}, \code{\link[SeqArray]{seqGDS2BED}},
    \code{\link[SeqArray]{seqGDS2VCF}}
}

\examples{
pgen_fn <- system.file("extdata", "plink2_gen.pgen", package="pgen2gds")

# PGEN to GDS
seqPGEN2GDS(pgen_fn, out.gdsfn="test.gds")

# GDS to PGEN
seqGDS2PGEN("test.gds", "test_out")

head(seqReadPVAR("test_out.pvar"))

# delete the temporary files
unlink(c("test.gds", "test_out.pgen", "test_out.pvar", "test_out.psam"),
    force=TRUE)
}

\keyword{GDS}
\keyword{PLINK2}
\keyword{utilities}
